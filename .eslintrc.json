{
    "extends": [
      "next/core-web-vitals", 
      "plugin:@typescript-eslint/recommended"
    ],
    "plugins": ["@typescript-eslint"],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module",
      "project": "./tsconfig.json"
    },
    "rules": {
      "unused-imports/no-unused-imports": "error", // Show an error if unused imports are found
    "unused-imports/no-unused-vars": [
      "warn", // Show a warning for unused variables
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_"
      }
    ],
      "@typescript-eslint/no-explicit-any": "off",  // Disable the rule globally
      "@typescript-eslint/explicit-function-return-type": "warn", // Show a warning if a return type is missing
      "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
      "eqeqeq": ["error", "always"], // Show an error if == is used instead of ===
      "no-shadow": "warn", // Show a warning if a variable is shadowed
      "no-duplicate-imports": "error", // Show an error if a module is imported multiple times
      "no-nested-ternary": "warn" // Show a warning if a nested ternary is found
    }
  }
  
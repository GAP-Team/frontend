{
  "extends": ["next/core-web-vitals"],
  "plugins": ["@typescript-eslint"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "off", // Disable the rule globally
    "@typescript-eslint/explicit-function-return-type": "error", // Show a warning if a return type is missing
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_" }
    ],
    "eqeqeq": ["error", "always"], // Show an error if == is used instead of ===
    "no-shadow": "warn", // Show a warning if a variable is shadowed
    "no-duplicate-imports": "error", // Show an error if a module is imported multiple times
    "no-nested-ternary": "warn", // Show a warning if a nested ternary is found
    "no-unsafe-optional-chaining": "warn", // Show a warning if an unsafe optional chaining is found
    "camelcase": "error", // Show a warning if a variable is not camelCase
    "complexity": ["warn", 5], // Show a warning if a function has a cyclomatic complexity greater than 5
    "max-lines-per-function": ["warn", 50], // Show a warning if a function has more than 50 lines
    "no-console": "warn", // Show a warning if console.log is used
    "no-undefined": "warn", // Show a warning if undefined is used
    "prefer-arrow-callback": "error", // Show a warning if a function is not an arrow function
    "@typescript-eslint/no-empty-interface": "off" // Show an error if an empty interface is found
  }
}
